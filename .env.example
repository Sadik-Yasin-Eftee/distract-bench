# DISTRACT-BENCH environment variables
#
# WHAT: Names of the API keys required to run the full pipeline.
# WHY: Keys are loaded via python-dotenv (see config.py) and must never be
#      committed to version control. Copy this file to `.env` and fill in
#      real values there; `.env` is gitignored.

# Google AI Studio API key.
# Used by models/gemini_client.py to call Gemini 2.0 Flash Thinking and
# Gemini 2.5 Flash (reasoning models with an explicit thinking_budget
# parameter), and by distractors/generator.py to call Gemini Flash as the
# distractor-generator model.
GOOGLE_API_KEY=

# DeepSeek API key (OpenAI-compatible endpoint at https://api.deepseek.com).
# Used by models/deepseek_client.py to call deepseek-reasoner (DeepSeek-R1),
# our second reasoning-model family, chosen because it is a fully
# open-weight model trained with RLVR and exposes reasoning content.
DEEPSEEK_API_KEY=

# Groq API key (OpenAI-compatible endpoint).
# Used by models/groq_client.py to call llama-3.3-70b-versatile, the
# non-reasoning baseline that shows whether inverse scaling under
# distractor noise is specific to models with explicit reasoning tokens.
GROQ_API_KEY=
