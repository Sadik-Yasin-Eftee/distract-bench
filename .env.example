# DISTRACT-BENCH environment variables
#
# WHAT: Names of the API keys used across the full pipeline.
# WHY: Keys are loaded via python-dotenv (see config.py) and must never be
#      committed to version control. Copy this file to `.env` and fill in
#      real values there; `.env` is gitignored.
#
# NONE OF THESE ARE STRICTLY REQUIRED TOGETHER: leave any key blank and
# experiments/run_scaling_curves.py automatically skips that provider's
# model(s) rather than failing — see README.md §2.2. GOOGLE_API_KEY alone
# is enough to build the benchmark (distractors/build_benchmark.py only
# ever calls Gemini) and to run the experiment against the two Gemini
# models.

# Google AI Studio API key. Get one at https://aistudio.google.com/apikey
# Used by models/gemini_client.py to call gemini-3.5-flash and
# gemini-3.6-flash (reasoning models with an explicit thinking_budget
# parameter — see config.py's MODEL_SPECS for why these replace the
# originally-planned Gemini 2.0/2.5 models, which are retired), and by
# distractors/generator.py to call gemini-3.5-flash-lite as the
# distractor-generator model.
GOOGLE_API_KEY=

# DeepSeek API key. Get one at https://platform.deepseek.com/api_keys
# (OpenAI-compatible endpoint at https://api.deepseek.com)
# Used by models/deepseek_client.py to call deepseek-flash in thinking
# mode (DeepSeek-R1's current model id — see config.py's MODEL_SPECS),
# our second reasoning-model family, chosen because it is a fully
# open-weight model trained with RLVR and exposes reasoning content.
DEEPSEEK_API_KEY=

# Groq API key. Get one at https://console.groq.com/keys
# (OpenAI-compatible endpoint)
# Used by models/groq_client.py to call a non-reasoning Llama baseline —
# the exact model id is resolved at runtime against Groq's live model
# list (see config.py's MODEL_SPECS and models/groq_client.py) since
# Groq deprecates specific model ids frequently.
GROQ_API_KEY=
